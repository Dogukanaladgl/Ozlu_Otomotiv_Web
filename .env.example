# Public site URL (no trailing slash). Used for canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — server-side only. Never expose to the browser.
RESEND_API_KEY=

# Verified sender address in Resend (e.g. "Özlü Otomotiv <bildirim@yourdomain.com>")
RESEND_FROM_EMAIL=

# Inbox that receives spare-part inquiries
CONTACT_RECIPIENT_EMAIL=
