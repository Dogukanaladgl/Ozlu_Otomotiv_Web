# Public site URL (no trailing slash).
# Development: optional (falls back to http://localhost:3000).
# Production / Vercel: REQUIRED — must be a valid HTTPS origin (never localhost).
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — server-side only. Never expose to the browser.
RESEND_API_KEY= 

# Verified sender on the ozluotomotiv.com domain in Resend.
# Do not use a Hotmail/Gmail address here. Empty or onboarding@resend.dev
# falls back to: Özlü Otomotiv <bildirim@ozluotomotiv.com>
RESEND_FROM_EMAIL=Özlü Otomotiv <bildirim@ozluotomotiv.com>

# Inbox that receives spare-part inquiries. Falls back to the public business email.
CONTACT_RECIPIENT_EMAIL=murat.ozlu@hotmail.com
